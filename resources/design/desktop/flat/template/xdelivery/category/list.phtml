<script type="text/javascript"
        src="/app/sae/design/desktop/flat/js/dynatable/jquery.dynatable.js"></script>

<style type="text/css">
    #dynamic-category {
        margin-top: 15px;
    }
</style>

<script type="text/javascript">
    var uriParams = {};
    let rowTemplate = `
    <tr class="dynarow" id="element_(ID)">
        <td><i class="fa fa-arrows" aria-hidden="true"></i></td>
        <td><img src="/images/application/(IMAGE)" width="40px" height="40px"></td>
        <td>(NAME)</td>
        <td>(STATUS)</td>
        <td>(ISPOPULAR)</td>
        <td> 
          <a class="sub-category btn btn-xs btn-warning" href="/xdelivery/category/subcategory/id/(ID)">
             <?php echo  p__("xdelivery", "Sub Category"); ?> [(SUBCATEGORY_COUNT)]
          </a>
          </td>
        <td>
        <a class="edit-category btn btn-xs btn-info" href="/xdelivery/category/edit/id/(ID)">
            <?php echo  p__("xdelivery", "Edit"); ?>
          </a>
        </td>
        <td> 
          <a class="delete-category btn btn-xs btn-danger" href="/xdelivery/category/delete/id/(ID)">
             <?php echo  p__("xdelivery", "Delete"); ?>
          </a>
        </td>
       
    </tr>`;

    function rowWriter(rowIndex, record, columns, cellWriter) {
        return rowTemplate
            .replace(/\(ID\)/g, record.id)    
            .replace(/\(IMAGE\)/g, record.image)        
            .replace(/\(NAME\)/g, record.category_name)
            .replace(/\(STATUS\)/g, record.is_active)
            .replace(/\(SUBCATEGORY_COUNT\)/g, record.subcategory_count)
            .replace(/\(ISPOPULAR\)/g, record.is_popular_search);
    }
    $.dynatableSetup({
        table: {
            defaultColumnIdStyle: 'noStyle'
        },
        features: {
            paginate: true,
            sort: true,
            pushState: true,
            search: true,
            recordCount: true,
            perPageSelect: false,
        },
    });

    let tableCustomers = $('#dynamic-category');

    tableCustomers.bind('dynatable:preinit', function(e, dynatable) {
        dynatable.utility.textTransform.noStyle = function(text) {
            return text;
        };
    });
 
    tableCustomers.bind('dynatable:afterProcess', function (e, data) {
        uriParams = data.queries;
    });
    
     tableCustomers.bind('dynatable:push', function(e, dynatable) {
          uriParams = dynatable.queries;   
    });

    // And on the table
    tableCustomers.dynatable({
        dataset: {
            ajax: true,
            ajaxUrl: '/xdelivery/category/find-all',
            ajaxOnLoad: true,
            records: [],
            perPageDefault: 25
        },
        inputs: {
            processingText: '<?php echo __jss("Loading ...") ?>',
            searchPlaceholder: '<?php echo __jss("Search Category ...") ?>',
            recordCountText: '<?php echo __jss("Showing") ?> ',
            filteredFrom: ' (<?php echo __jss("filtered from #TOTAL# total records") ?>)',
            recordText: '<?php echo __jss("record") ?>',
            recordTextPlural: '<?php echo __jss("records") ?>',
            textOf: '<?php echo __jss("of") ?>',
            textTo: '<?php echo __jss("to") ?>',
            queries: $('.dt-search')
        },
        writers: {
            _rowWriter: rowWriter
        }
    });

    $(document).off("click", ".delete-category");
    $(document).on("click", ".delete-category", function (e) {
        e.preventDefault();
        let deleteHref = $(this).attr("href");
        swal({
            title: "<?php echo P__("xdelivery", "Confirmation") ?>",
            text: "<?php echo P__("xdelivery", "Are you sure you want to delete this Category?") ?>",
            showCancelButton: true,
            confirmButtonColor: '#0099C7',
            confirmButtonText: "<?php echo P__("xdelivery", "Yes, delete!")?>",
            cancelButtonText: "<?php echo P__("xdelivery", "No, go back") ?>",
            buttons: true
        }, function(value) {
            if (!value) {
                return false;
            }

            formget(deleteHref,
                {},
                function (data) {
                    feature_form_success(data.message);
                   // Reload only on success and when done!
                    setTimeout(function () {
                        location.reload();
                    }, 1500)
                },
                function (data) {
                    feature_form_error(JSON.parse(data.responseText).message);
                },
                false);
        });
    });

   var $tabs = $('#dynamic-category');
    $(document).ready(function() {   
     $( "tbody.connectedSortable" )
        .sortable({
            connectWith: ".connectedSortable",
            appendTo: $tabs,
            helper:"clone",
            cursor: 'move',
            zIndex: 999990,
            stop: function (event, ui) {
                var data = $(this).sortable('toArray');  
                           
               $.ajax({
                    method: "POST",
                    url : "<?php echo $this->getUrl('xdelivery/category/sortable'); ?>",
                    data : { data : data, parent_id : 0 }
                  }).done(function( msg ) {
                 });
          }
        })
        .disableSelection();
    });
 
 </script>

