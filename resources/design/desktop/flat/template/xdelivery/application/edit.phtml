    function deletePrinter(printer_id) {

        if (printer_id) {

            var message =
                '<?php echo p__('xdelivery', "All the data related to that printer will be lost. Are you sure you want to delete?"); ?>';

            if (confirm(message)) {

                var url = '<?php echo $this->getUrl('xdelivery/printer/deleteprinter'); ?>/printer_id/' + printer_id;

                reload(this, url, true, function(datas) {

                    if (datas.success) {

                        page.reload();

                    }

                });

            }

        }

    }
