<script type="text/javascript">
    function initMap() {
        var autocomplete = new google.maps.places.Autocomplete($("#store_location")[0], {});
        google.maps.event.addListener(autocomplete, 'place_changed', function() {
            var place = autocomplete.getPlace();
            var near_place = autocomplete.getPlace();
            document.getElementById('address_lat').value = near_place.geometry.location.lat();
            document.getElementById('address_lng').value = near_place.geometry.location.lng();
        });
    }
</script>
<script type="text/javascript"
    src="https://maps.googleapis.com/maps/api/js?sensor=false&key=<?php echo $googlemaps_key; ?>&libraries=places&callback=initMap">
</script>
