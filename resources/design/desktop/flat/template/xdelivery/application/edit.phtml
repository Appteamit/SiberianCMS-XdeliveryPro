                $("#home_screen option[value='store']").hide();
                $("#home_screen option[value='product']").show();
                $("#home_screen option[value='category']").show();
                $("#home_screen").children("option[value='category']").prop('selected', true);
            } else {
                $("#home_screen option[value='store']").show();
                $("#home_screen option[value='product']").hide();
                $("#home_screen option[value='category']").hide();
                $("#home_screen").children("option[value='store']").prop('selected', true);
