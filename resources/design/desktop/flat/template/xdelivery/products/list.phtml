});
var uriParams = {};
let rowTemplate = `
    <tr class="dynarow">
        <td>#(ID)</td>
        <td><img src="(IMAGE)" width="40px" height="40px"></td>
        <td><b>(NAME) - <i>(PRODUCTTYPE)</i></b><br>(STORE)</td>
        <td>(SKU)</td>
        <td>(STOCK)</td>
        <td>(STATUS)</td>
        <td><span class="(ISSPECIALHIDE)">(PRICE)</span><span class="(ISSPECIALSHOW)">(SPECIALPRICE) <del>(PRICE)</del></span></td> 
        <td> 
            <a target="_blank" btn btn-xs btn-default" href="/xdelivery/products/qrcode/value_id/(VALUEID)/id/(ID)">
             <i class="fa fa-qrcode" aria-hidden="true"></i>
            </a>
        </td>       
        <td>
            <a class="edit-category btn btn-xs btn-info" href="/xdelivery/products/edit/id/(ID)">
             <?php echo  p__("xdelivery", "Edit"); ?>
            </a>
        </td>
        <td> 
            <a class="delete-product btn btn-xs btn-danger" href="/xdelivery/products/delete/id/(ID)">
             <?php echo  p__("xdelivery", "Delete"); ?>
            </a>
        </td>
    </tr>`;

function rowWriter(rowIndex, record, columns, cellWriter) {
    var isSpecialhide = record.active_special_price == 1 ? 'hide' : 'show';
    var isSpecialshow = record.active_special_price == 1 ? 'show' : 'hide';

    return rowTemplate
        .replace(/\(ID\)/g, record.id)
        .replace(/\(NAME\)/g, record.product_name)
        .replace(/\(SKU\)/g, record.sku)
        .replace(/\(STOCK\)/g, record.stock)
        .replace(/\(PRICE\)/g, record.price)
        .replace(/\(SPECIALPRICE\)/g, record.special_price)
        .replace(/\(SPECIALPRICEACTIVE\)/g, record.active_special_price)
        .replace(/\(ISSPECIALHIDE\)/g, isSpecialhide)
        .replace(/\(ISSPECIALSHOW\)/g, isSpecialshow)
        .replace(/\(STATUS\)/g, record.is_active)
        .replace(/\(VALUEID\)/g, record.value_id)
        .replace(/\(STORE\)/g, record.store_name)
        .replace(/\(PRODUCTTYPE\)/g, record.product_type)
        .replace(/\(IMAGE\)/g, record.product_image);
}
$.dynatableSetup({
    table: {
        defaultColumnIdStyle: 'noStyle'
    },
    features: {
        paginate: true,
        sort: true,
        pushState: true,
