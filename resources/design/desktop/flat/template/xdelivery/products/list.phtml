<script type="text/javascript">
$('#importSetupForm').submit(function(e) {
    e.preventDefault();
    $("#mask").show();
    if ($('#csv_file').val() == '') {
        $("#mask").hide();
        return;
    }
    var fd = new FormData();
    var files = $('#csv_file')[0].files[0];
    fd.append('csv_file', files);
    fd.append('value_id', $('#value_id').val());
    $.ajax({
        url: this.action,
        type: 'post',
        data: fd,
        contentType: false,
        processData: false,
    }).done(function(response) {
        console.log("My Reposnse");
        res = JSON.parse(response);
        console.log(res);
        
        if (res.success == true) {
            location.reload();
        } else {
            // $("#response_type").val(2);
        }
    }).fail(function(response) {
        alert("error");
    }).always(function(response) {
        $("#mask").hide();
        // $("#submit_response_form").trigger("click");
    });
    return false;
});
