    $parentCategory = $this->getParentCategory();
    $value_id = (new Xdelivery_Model_Xdelivery())->getCurrentValueId();
    $attributes = (new Xdelivery_Model_Attribute())->findAll(['value_id' => $value_id, "is_active" => 1], 'position ASC')->toArray();
    $taxes = (new Xdelivery_Model_Tax())->findAll($value_id);
    $categories = (new Xdelivery_Model_Category())->getCategorySubCategory($value_id); 
    $product_categories = $this->getProductCategory();
    $productattrObj = $this->getProductAttributes();
    $product = $this->getProduct();
    $childProduct = $this->getChildProduct();

    $product_attributes = [];
    $attribute_value_ids = [];
    $is_variant_available = false;

    foreach ($productattrObj as $key => $value) {
        $product_attributes[$value['attribute_id']]['values'][] = $value;
        $product_attributes[$value['attribute_id']]['name'] = $value['attribute_name'];
        $product_attributes[$value['attribute_id']]['is_variant'] = $value['is_variant'];      
        $attribute_value_ids[] = $value['attribute_value_id'];

        if(!$is_variant_available && $value['is_variant'] == 1){
            $is_variant_available = true;
        }
    }

    $productAttributesKeys = array_keys($product_attributes);
  
    if(!empty($productAttributesKeys)){
        $attributesValues = (new Xdelivery_Model_AttributeValues())->findAll(['attribute_id IN (?)' =>  $productAttributesKeys])->toArray();
        $product_all_attributes = [];
        foreach ($attributesValues as $key => $value) {
            $product_all_attributes[$value['attribute_id']]['values'][] = $value;
            $product_all_attributes[$value['attribute_id']]['name'] = $product_attributes[$value['attribute_id']]['name'];
            $product_all_attributes[$value['attribute_id']]['attribute_id'] = $key;
            $product_all_attributes[$value['attribute_id']]['is_variant'] = $product_attributes[$value['attribute_id']]['is_variant'];;
            
        }
    }
  
    $extraOption = (new Xdelivery_Model_ExtraOption())
                ->findByValueId($value_id, ['is_active' => 1])->toArray();
   
    $extraOptionProduct = (new Xdelivery_Model_ExtraOptionProduct())
                ->findAll(['product_id' => $product['id'], 'is_active' => 1])->toArray();
    $optionIds = [];
    foreach ($extraOptionProduct as $opkey => $opvalue) {
        $optionIds[] = $opvalue['option_id'];
    }

    $brands = (new Xdelivery_Model_Brand())->findByValueId($value_id, ['is_active' => 1])->toArray();
    $stores = (new Xdelivery_Model_Store())->findAll(['value_id' => $value_id, 'is_active' => 1 ]);
 ?>

