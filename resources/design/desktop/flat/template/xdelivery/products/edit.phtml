                $( "#new_from" ).datepicker( "option", "maxDate", selectedDate );
            }
        });    

        /*Manage stock settings*/
        function manageStock() {
            if($('#manage_stock').is(":checked")){
                $('#in_stock').parent().parent().hide();
                $('#qty').parent().parent().show();
                $('#low_stock_threshold').parent().parent().show();
                $('#qty').addClass('required');
                $('#low_stock_threshold').addClass('required');
            }else{
                $('#in_stock').parent().parent().show();
                $('#qty').parent().parent().hide();
                $('#low_stock_threshold').parent().parent().hide();
                $('#qty').removeClass('required');
                $('#low_stock_threshold').removeClass('required');
            }
        }

        manageStock(); // On Load        
       
        $('#manage_stock').on("change", function(){
            manageStock();                    
        });    
 
        $(document).on('click','.remove_value_button',function(e){
              var id = $(this).data('id');  
              var isNew = $(this).data('new');
              if(isNew){
                $("#attribute_value_box_"+id).remove();
              }else{
                // Call Ajax Function for deleting values from database
                 e.preventDefault();
                let deleteHref = $(this).data("href");
                swal({
                    title: "<?php echo P__("xdelivery", "Confirmation") ?>",
                    text: "<?php echo P__("xdelivery", "Are you sure you want to delete this attributes?") ?>",
                    showCancelButton: true,
                    confirmButtonColor: '#0099C7',
                    confirmButtonText: "<?php echo P__("xdelivery", "Yes, delete!")?>",
                    cancelButtonText: "<?php echo P__("xdelivery", "No, go back") ?>",
                    buttons: true
                }, function(value) {
                    if (!value) {
                        return false;
                    }

                    formget(deleteHref,
                        {},
                        function (data) {
                            feature_form_success(data.message);
                           // Reload only on success and when done!
                            setTimeout(function () {
                                location.reload();
                            }, 1500)
                        },
                        function (data) {
                            feature_form_error(JSON.parse(data.responseText).message);
                        },
                        false);
                });
             

              }
         });

        setTimeout(function(){
            $('.attribute_values').multiselect('refresh'); 
            $('.attribute_values').multiselect({
                                    columns: 4,
                                    search: true,
                                    selectAll: true
                                }); 

         }, 300);

     
         /*Simple and variant option*/
        $('#product_type').on("change", function(){            
            if($(this).val() == 'simple'){
                $('.simple_product_box').show();
                $('#variant_button_save').hide();                
                $('#price').addClass('required');
            }else{
                $('.simple_product_box').hide();
                $('#variant_button_save').show();
                $('#price').removeClass('required');
            } 
        });


    });

    var is_gallery = false;
    /*Image Upload*/
    $(".uploadGalleryImage").click(function (e) {
        is_gallery = true;
        $('#product_image_file').trigger('click'); 
    });
   
    /*Image Upload*/
    $(".uploadSingleImage").click(function (e) {
        $('#product_image_file').trigger('click'); 
    });

    var Uploader = new Uploader();
    var image_view_template = '<?php echo str_replace("\n", "", '<div class="cms-image" style="background-image: url(#THUMBNAIL_PATH#);"><img src="/images/application/placeholder/blank-512.png"  width="200px" height="200px" class="cms-image-unit" /><input type="hidden" name="images[]" value="%IMAGE_PATH%" /></div>' ); ?>';

      var image_gallery_view_template = '<?php echo str_replace("\n", "", '<div class="cms-image" style="background-image: url(#THUMBNAIL_PATH#);"><div class="product-image-delete"><i class="fa fa-times"></i></div><img src="/images/application/placeholder/blank-512.png"  width="200px" height="200px" class="cms-image-unit" /><input type="hidden" name="gallery[]" value="%IMAGE_PATH%" /></div>' ); ?>';
    
    $(document).on("click", ".product-image-delete", function() {
        var el = $(this);
        el.parents(".cms-image").remove();
    });

    $('#product_image_file').fileupload({
        dataType: 'json',
        add: function(e, data) {
            data.submit();
            Uploader.showProgressbar();
        },
        progressall: function(e, data) {
            Uploader.moveProgressbar(data);
        },
        fail: function (el, data) {
            Uploader.hide();
            Uploader.showError(JSON.parse(data.jqXHR.responseText).message);
        },
        done: function(e, data) {
            if (data.result.error) {
                Uploader.hide();
                Uploader.showError(data.result.message);
            }
            if (data.result.success) {
                Uploader.hide();
                var params = [];
                params["url"] = '<?php echo $this->getUrl('template/crop/crop'); ?>';
                params["file"] = data.result.files;
                params["output_w"] = 600;
                params["output_h"] = 600;
                params["output_url"] = '<?php echo str_replace('/', '$', $this->getUrl('xdelivery/application/crop')) ?>';
                params["uploader"] = 'Uploader';
                Uploader.crop(params);

                Uploader.callback = function(file) {
                    if(is_gallery){
                         var cms_image = image_gallery_view_template;
                    }else{
                         var cms_image = image_view_template;
                    }                      
                    cms_image = cms_image.replace("%IMAGE_PATH%", file);
                    cms_image = cms_image.replace("#THUMBNAIL_PATH#",  '<?php echo Core_Model_Directory::getTmpDirectory(); ?>/' + file);
                    if(is_gallery){
                        $(".product-images-gallery-container").append(cms_image);
                    }else{
                       $(".product-images-container").html(cms_image);
                    }
                    $(".change-messages").html('Click on Publish button for changes');
                };
            }
        }
    });

   /*End Image upload code*/
   
