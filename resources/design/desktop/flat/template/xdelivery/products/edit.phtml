        $.ajax({
            url: '/application/customization_features/links',
            method: 'GET',
            dataType: 'json',
            success: function (data) {
                window.feature_links = data;
            }
        });
        
       $('#productForm').submit(function() {
            if($(this).valid()) {
                reload(this, this.action, true, function(data) {
                    if(data.success) {
                        feature_form_success(data.message);
                        setTimeout(function () {
                            location.reload();
                        }, 300)
                    }else{
                        feature_form_error(data.message);
                    }
                });
            }
            return false;
        });

        $('.attribute-add-button').click(function(event) {
            event.preventDefault();
            reload( {} , $('#attribute_product_url').attr( "href" )+'/id/'+$('#select_attribute').val() , true, function(datas) {
                if(datas.success){
                    if ($('#attribute_values_'+datas.id).length){
                        alert('Already added this attribute');
                        return false;

                    }else{
                        $('#attribute_product_values').append(datas.html);
                        $("#select_attribute").find("option").prop("selected", false);
                        setTimeout(function(){ 
                             $('#attribute_values_'+datas.id).multiselect('refresh');
                            $('#attribute_values_'+datas.id).multiselect({
                                                    columns: 4,
                                                    search: true,
                                                    selectAll: true
                                                }); 

                         }, 300);
                    }                    
               }
            });

          return false;
       });
 
        /*Date Pickers*/
