                showCancelButton: true,
                confirmButtonColor: '#0099C7',
                confirmButtonText: '<?php echo P__("xdelivery", "Yes, delete!")?>',
                cancelButtonText: '<?php echo P__("xdelivery", "No, go back") ?>',
                buttons: true
            }, function(value) {
                if (!value) {
                    return false;
                }
                formget(deleteHref,
                    {},
                    function (data) {
                        feature_form_success(data.message);
                        // Reload only on success and when done!
                        setTimeout(function () {
                            location.reload();
                        }, 1500)
                    },
                    function (data) {
                        feature_form_error(JSON.parse(data.responseText).message);
                    },
                    false);
            });
        });


