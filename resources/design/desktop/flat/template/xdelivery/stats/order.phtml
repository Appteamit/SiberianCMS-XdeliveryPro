<script>
// START Date Picker
var today = new Date(); // get current date
var oneYearAgo = new Date(); // create new date object
oneYearAgo.setFullYear(today.getFullYear() - 1); // set year to previous year
if ($.datepicker.regional['<?php echo Core_Model_Language::getCurrentLanguageDatepicker(); ?>']) {
    $.datepicker.setDefaults($.datepicker.regional[
        '<?php echo Core_Model_Language::getCurrentLanguageDatepicker(); ?>']);
} else {
    $.datepicker.setDefaults($.datepicker.regional['en']);
}

$("#from").datepicker({
    changeMonth: true,
    changeYear: true,
    numberOfMonths: 3,
    minDate: oneYearAgo,
    onClose: function(selectedDate) {
        $("#to").datepicker("option", "minDate", selectedDate);
    }
});

$("#to").datepicker({
    changeMonth: true,
    changeYear: true,
    numberOfMonths: 3,
    onClose: function(selectedDate) {
        $("#from").datepicker("option", "maxDate", selectedDate);
    }
});
$("#to").datepicker('setDate', new Date());
$("#from").datepicker('setDate', -30);

function computeDateRange() {
    var start_timestamp = parseInt($.datepicker.formatDate("@", $("#from").datepicker("getDate")) / 1000);
    var end_timestamp = parseInt($.datepicker.formatDate("@", $("#to").datepicker("getDate")) / 1000);
    //We go to 23:59
    end_timestamp = end_timestamp + (60 * 60 * 24) - 60;
    date_range = {
        "start": start_timestamp,
        "end": end_timestamp
    };
    return date_range;
}
var date_range_params = '';

function filterStats() {
    if ($("#from").val() && $("#to").val()) {
        date_range_params = computeDateRange();
        if (date_range_params.start <= date_range_params.end) {
            console.log("Called");
        } else {
            var page_message = new AlertMessage(
                "<?php echo p__('xdelivery',"Start date must be lower than end date."); ?>");
            page_message.addButton(true);
            page_message.setTimer(false);
            page_message.isError(true);
            page_message.show();
        }
    } else {
        var page_message = new AlertMessage(
            "<?php echo p__('xdelivery',"You have to chose a start and an end date."); ?>");
        page_message.addButton(true);
        page_message.setTimer(false);
        page_message.isError(true);
        page_message.show();
    }
}
// END Date Picker    
// Chart identifiers
var date_range_orders_ctx = $("#date_range_orders");
var total_orders_ctx = $("#total_orders");
// Bar Chart Configrations                       
var datasetMeta = [{
    label: "<?php echo p__('xdelivery',"Gross Order Values Overview"); ?>",
    backgroundColor: "#0099C7",
    borderColor: "#0099C7",
    borderWidth: 1,
    hoverBackgroundColor: "#0099C7",
    hoverBorderColor: "#0099C7",
    data: []
}];
var lineChartConfig = {
    type: 'line',
    data: {
        labels: [],
        datasets: datasetMeta
    },
    options: {
        "responsive": true,
        maintainAspectRatio: false,
        scales: {
            y: {
                min: 0,
                ticks: {
                    precision: 0
                }
            }
        },
        plugins: {
            tooltip: {
                callbacks: {
                    title: function(context) {
                        if (context[0].datasetIndex === 1) {
                            return prev_total_ref_labels[context[0].dataIndex];
                        }
                    }
                }
            }
        }
    }
};
// END line Chart Configrations        
// Report Range Section
var prev_total_ref_labels = [];
var date_range_orders = new Chart(date_range_orders_ctx, lineChartConfig);
var total_orders = new Chart(total_orders_ctx, lineChartConfig);
// Empty No Graph
loadOrdersStats();
var is_custome_date_filter = 0;

function filterType() {
    range_filter = $("#range_filter").val();
    if (range_filter == 100) {
        is_custome_date_filter = 1;
        $("#custom_date_filter_container").show();
    } else {
        is_custome_date_filter = 0;
        $("#custom_date_filter_container").hide();
    }
}

function loadOrdersStats() {
    //Show loaders  
    $("#date_range_orders_loader").show();
    $("#total_orders_loader").show();
    range_filter = $("#range_filter").val();
    store_id = $("#store_id").val();
    order_status = $("#order_status").val();
    filterStats();
    $(".dfault-0").text(0); //Reset stats to 0
    $(".avg-dfault-na").text('<?php echo p__('xdelivery',"AVG N/A"); ?>'); //Reset stats to 0
    $.ajax({
        method: "POST",
        dataType: 'json',
        url: "/xdelivery/stats/orderstats",
        data: {
            app_id: '<?php echo $app_id; ?>',
            value_id: '<?php echo $value_id; ?>',
            range_filter: range_filter,
            order_status: order_status,
            store_id: store_id,
            date_range_params: date_range_params,
            is_custome_date_filter: is_custome_date_filter
        }
    }).done(function(data) {
        if (true) { // (Total Orders Line Chart)                                
            var total_ref_labels = [];
            var total_ref = [];
            var success_ref = [];
            $.each(data.total_graph_orders, function(ind, elem) {
                total_ref_labels.push(elem.labels);
                prev_total_ref_labels.push(elem.prev_labels);
                total_ref.push(elem.total_net_orders);
                success_ref.push(elem.prev_ref);
            });
            total_orders.data.datasets[0].data = total_ref;
            total_orders.data.labels = total_ref_labels;
            total_orders.update();
        }
        if (true) { // Total Orders Count Show           
            if (data.total_orders_count[0]) {
                var ordersData = data.total_orders_count[0];
                if (ordersData.total_count !== null) {
                    $("#total_orders_count").text(ordersData.total_count);
                }
                if (ordersData.total_gross !== null) {
                    $("#total_orders_gross").text(ordersData.total_gross);
                    $("#average_orders_gross").text("AVG " + ordersData.average_gross);
                }
                if (ordersData.total_discount !== null) {
                    $("#total_orders_discount").text(ordersData.total_discount);
                    $("#average_orders_discount").text("AVG " + ordersData.average_discount);
                }
                if (ordersData.total_tip !== null) {
                    $("#total_orders_tip").text(ordersData.total_tip);
                    $("#average_orders_tip").text("AVG " + ordersData.average_tip);
                }
                if (ordersData.total_delivery !== null) {
                    $("#total_orders_delivery").text(ordersData.total_delivery);
                    $("#average_orders_delivery").text("AVG " + ordersData.average_delivery);
                }
                if (ordersData.total_tax !== null) {
                    $("#total_orders_tax").text(ordersData.total_tax);
                    $("#average_orders_tax").text("AVG " + ordersData.average_tax);
                }

            }
            $("#total_orders_loader").hide();

            // Background Work for PDF PRINT
            const divElement = document.getElementById('pagecontainer');
            // Get the innerHTML of the div element
            const htmlContent = divElement.innerHTML;
            $("#newcontent").remove();
            // Create a new element to pass the same data
            newElement = document.createElement('div');
            newElement.setAttribute('id', 'newcontent');
            newElement.style.width = '1284px';
            newElement.style.marginLeft = '200px';
            newElement.style.position = "absolute";
            newElement.style.bottom = "100%";
            newElement.innerHTML = htmlContent;
            // Get the duplicated chart canvas and chart instance
            duplicateChartCanvas = newElement.querySelector('#total_orders');
            duplicateChart = new Chart(duplicateChartCanvas, {
                type: total_orders.config.type,
                data: total_orders.config.data,
                options: total_orders.config.options
            });
            duplicateChartCanvas.style.height = '348px';
            // Manage filter elements for print
            from_date = $("#from").val();
            to_date = $("#to").val();
            range_filter = $("#range_filter").val();
            myDropdown = newElement.querySelector('#range_filter');
            optionWithValue100 = myDropdown.querySelector(`option[value="${range_filter}"]`);
            optionWithValue100.selected = true;

            store_filter = $("#store_id").val();
            myDropdown = newElement.querySelector('#store_id');
            optionWithValue100 = myDropdown.querySelector(`option[value="${store_filter}"]`);
            optionWithValue100.selected = true;

            fromInput = newElement.querySelector('#from');
            fromInput.setAttribute('value', from_date);
            toInput = newElement.querySelector('#to');
            toInput.setAttribute('value', to_date);
            document.body.appendChild(newElement);
        }
    }).error(function() {
        console.log("Error");
    });
}
// PDF Print execution
function printPdf() {
    const doc = new jsPDF();
    html2canvas(newElement.querySelector("#content")).then((canvas) => {
        var imgData = canvas.toDataURL();
        var imgWidth = 210;
        var pageHeight = 295;
        var imgHeight = canvas.height * imgWidth / canvas.width;
        var heightLeft = imgHeight;
        var doc = new jsPDF('p', 'mm');
        var position = 3; // give some top padding to first page
        doc.addImage(imgData, 'JPEG', 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;
        while (heightLeft >= 0) {
            position = heightLeft - imgHeight; // top padding for other pages        
            doc.addPage();
            doc.addImage(imgData, 'JPEG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
        }
        doc.save('XDelivery Orders.pdf');
    });
}
</script>
